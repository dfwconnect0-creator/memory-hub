# ── Required ──────────────────────────────────────────────────────
# Gemini Embedding 2 (free, 768 dims, Arabic-native)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Master hub API key — used to authenticate requests to Memory Hub
HUB_API_KEY=your-hub-api-key-here

# ── Optional: Per-agent keys ───────────────────────────────────────
# JSON map of "api_key" -> "agent_id"
# ⚠ EVERY agent in agents.yaml MUST have a key here or it gets 403
# See docs/DEBUGGING_GUIDE.md issue #5
# Example: AGENT_KEYS={"cc_career_xyz": "career_coach_agent", "cr_research_xyz": "research_agent", ...}
AGENT_KEYS={}

# ── Content Researcher ─────────────────────────────────────────────
CONTENT_RESEARCHER_API_KEY=cr_research_xxxxxxxx

# ── Optional: Server settings ──────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
AGENTS_YAML_PATH=config/agents.yaml
